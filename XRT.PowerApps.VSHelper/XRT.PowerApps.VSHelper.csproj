  <!-- tasks for copying VSIX to Releases folder -->
  <Target Name="PostBuild_CopyVsix" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <GetAssemblyIdentity AssemblyFiles="$(TargetPath)">
      <Output TaskParameter="Assemblies" ItemName="CurrentAssembly" />
    </GetAssemblyIdentity>
    <PropertyGroup>
      <VersionedFileName>$(AssemblyName).%(CurrentAssembly.Version).vsix</VersionedFileName>
      <PublishDir>$(MSBuildProjectDirectory)\..\Releases</PublishDir>
      <BuiltVsixPath>$(OutputPath)$(AssemblyName).vsix</BuiltVsixPath>
      <TargetVsixPath>$(PublishDir)\$(VersionedFileName)</TargetVsixPath>
    </PropertyGroup>
    <Message Text="Creating Releases folder at: $(PublishDir)" Importance="high" />
    <MakeDir Directories="$(PublishDir)" />
    <Message Text="Copying VSIX to: $(TargetVsixPath)" Importance="high" />
    <Copy SourceFiles="$(BuiltVsixPath)" DestinationFiles="$(TargetVsixPath)" />
  </Target>
